---
import { profile } from '../../content/profile';
import { withBase } from '../../lib/urls';
import { publicFile } from '../../lib/public-files';
import Icon from './Icon.astro';

const links = [
  ['home', 'Home'],
  ...(profile.bio ? [['about', 'About']] : []),
  ['expertise', 'Expertise'],
  ...(profile.experience.length ? [['experience', 'Experience']] : []),
  ['projects', 'Projects'],
  ...(profile.services.length ? [['services', 'Services']] : []),
  ['contact', 'Contact']
];
const brand = profile.name ?? 'Embedded Engineering';
const onHome = Astro.url.pathname === withBase();
const resume = publicFile(profile.resume);
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={withBase()} aria-label={brand + ' home'}>
      <span class="brand-mark">{profile.initials || <Icon name="chip" size={22} />}</span>
      <span>{brand}</span>
    </a>
    <button id="menu-toggle" class="icon-button menu-toggle" aria-label="Menu" aria-controls="site-nav" aria-expanded="false" type="button" hidden>
      <Icon name="menu" />
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      {links.map(([id, label]) => (
        <a href={onHome ? '#' + id : withBase('#' + id)} data-section={onHome ? id : undefined}
          aria-current={onHome && id === 'home' ? 'location' : undefined}>{label}</a>
      ))}
      {resume && <a class="resume-mobile" href={withBase(resume)} download>Download résumé</a>}
    </nav>
    <div class="header-actions">
      {resume && <a class="resume-link" href={withBase(resume)} download>Résumé <Icon name="download" size={16} /></a>}
      <button id="theme-toggle" class="icon-button theme-toggle" type="button" aria-label="Switch theme" hidden>
        <span class="theme-icon-light"><Icon name="moon" size={18} /></span>
        <span class="theme-icon-dark"><Icon name="sun" size={18} /></span>
      </button>
    </div>
  </div>
</header>
