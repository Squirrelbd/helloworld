---
import { publishedProjects } from '../../lib/projects';
import { publicFile } from '../../lib/public-files';
import { projectHref, withBase } from '../../lib/urls';
import Icon from '../site/Icon.astro';
import ProjectVisual from './ProjectVisual.astro';

const entries = await publishedProjects();
const categories = [...new Set(entries.filter(({ data }) => data.kind === 'project').map(({ data }) => data.category))].sort();
const canFilter = entries.filter(({ data }) => data.kind === 'project').length >= 4 && categories.length > 1;
---
<section id="projects" class="section work-section">
  <div class="wrap">
    <div class="section-intro">
      <div><p class="eyebrow">Case studies</p><h2>Selected work</h2></div>
      <p>Explore system architecture, design decisions, and how to validate them.</p>
    </div>
    {canFilter && <div class="project-filters" role="group" aria-label="Filter projects" hidden>
      <button type="button" data-filter="" aria-pressed="true">All</button>
      {categories.map((category) => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}
    </div>}
    <p class="filter-status" role="status" hidden></p>
    {entries.length === 0 && <p class="empty-state">Case studies will appear here when available.</p>}
    <div class="project-grid">
      {entries.map(({ data }) => {
        const imagePath = publicFile(data.image?.path);
        return (
          <article class="project-card" data-category={data.category}>
            <div class="project-art" aria-hidden="true">
              {imagePath && data.image
                ? <img src={withBase(imagePath)} alt="" width={data.image.width} height={data.image.height} loading="lazy" decoding="async" />
                : <ProjectVisual />}
            </div>
            <div class="project-copy">
              <p class="eyebrow">{data.kind === 'reference' ? 'Reference design' : data.category}</p>
              <h3><a href={projectHref(data.slug)}>{data.title}</a></h3>
              <p>{data.summary}</p>
              {data.tags.length > 0 && <ul class="tag-list">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
              <a class="text-link" href={projectHref(data.slug)} aria-label={'Read case study: ' + data.title}>Read case study <Icon name="diagonal" size={17} /></a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
